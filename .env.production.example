APP_NAME="Trusted Advisors"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trustedadvisors.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=trusted_advisors
DB_USERNAME=trusted_advisors
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Auth service
AUTH_SERVICE_URL=https://auth.mpgames.io
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URI=${APP_URL}/auth/callback

# Webhooks
WEBHOOK_SECRET=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
VITE_ONESIGNAL_APP_ID="${ONESIGNAL_APP_ID}"

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Payment sandbox mode
PAYMENT_SANDBOX_MODE=false
